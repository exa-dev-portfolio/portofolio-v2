# =========================================================
# Portofolio v2 — Main Nuxt Application (.env.example)
# =========================================================

# --- Application & Server
NUXT_MODE=development
NUXT_PORT=3000
NUXT_DEBUG=false
NUXT_JWT_SECRET=change-me-super-secret-jwt-key
NUXT_CLIENT_URL=http://localhost:3000

# --- Public Client Variables
NUXT_PUBLIC_API_BASE_URL=http://localhost:3000
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_ENABLE_APK_STORE=true

# --- PostgreSQL Database (prefer NUXT_DATABASE_URL)
NUXT_DATABASE_URL=postgres://postgres:password@localhost:5432/portofolio-v2
# NUXT_PG_HOST=localhost
# NUXT_PG_PORT=5432
# NUXT_PG_USER=postgres
# NUXT_PG_PASSWORD=password
# NUXT_PG_DATABASE=portofolio-v2
# NUXT_PG_SSL=false
# NUXT_PG_MAX=10
# NUXT_PG_IDLE_TIMEOUT_MS=30000
# NUXT_PG_CONNECTION_TIMEOUT_MS=2000

# --- Redis & Asynq Task Queue
# Used for OTP verification, rate limiting, and native Asynq task scheduling
NUXT_REDIS_URL=redis://default:password@localhost:6379

# --- Background Worker Integration
# Communication with worker-portofolio-v2
NUXT_JOB_WORKER_URL=http://localhost:9090
NUXT_JOB_WORKER_SECRET=change-me-shared-secret

# --- Email Notifications (Resend API)
NUXT_RESEND_API_KEY=re_your_resend_api_key_here

# --- Gemini AI
NUXT_GEMINI_API_KEY=your_gemini_api_key_here

# --- MinIO Object Storage (APK Binaries, Screenshots & Icons)
NUXT_MINIO_ENDPOINT=storage.eka-dev.cloud
NUXT_MINIO_PORT=9000
NUXT_MINIO_ACCESS_KEY=your_minio_access_key
NUXT_MINIO_SECRET_KEY=your_minio_secret_key
NUXT_MINIO_USE_SSL=true

# --- OAuth Authentication (Google & Apple)
NUXT_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NUXT_GOOGLE_CLIENT_SECRET=your_google_client_secret
NUXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NUXT_APPLE_CLIENT_ID=cloud.eka-dev.portfolio
NUXT_PUBLIC_APPLE_CLIENT_ID=cloud.eka-dev.portfolio

# --- Apple App Store Connect API (Official TestFlight Invites)
# Generates ES256 JWT to invite beta testers directly from Apple email
NUXT_APPLE_ASC_KEY_ID=ABC123XYZ
NUXT_APPLE_ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# Private key: can be base64 string (recommended: base64 -i AuthKey_XXX.p8) OR raw PEM
NUXT_APPLE_ASC_PRIVATE_KEY=LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0t...
# NOTE: Beta Group ID is now configured per-app in the dashboard Store Links modal

# --- Google Play Developer Console (Closed / Internal Testing Track)
# Service Account: can be base64 string (recommended: base64 -i service-account.json) OR raw JSON
# NUXT_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=eyJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIs...
NUXT_GOOGLE_PLAY_TESTER_GROUP_EMAIL=internal-testers@googlegroups.com
